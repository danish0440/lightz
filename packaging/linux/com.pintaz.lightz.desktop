[Desktop Entry]
Type=Application
Name=LightZ
GenericName=Photo Library and Raw Developer
Comment=Organise photos and develop raw files, non-destructively
Exec=lightz %F
Icon=com.pintaz.lightz
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;raw;camera;library;develop;
StartupWMClass=com.pintaz.lightz
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/x-adobe-dng;image/x-sony-arw;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-rw;image/x-pentax-pef;
